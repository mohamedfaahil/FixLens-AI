# ==============================================================
# FixLens AI — Vercel & Supabase Environment Variables Reference
# ==============================================================
# In Vercel (Settings -> Environment Variables):
# Add for Production, Preview, and Development environments.

# --------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Exposed to browser via Vite bundle)
# --------------------------------------------------------------
VITE_SUPABASE_URL=https://snwcmuptrvmpniuevofj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CqxydmwI2c6JScSdFg5X4Q_HmwDzvk9
VITE_SUPABASE_PROJECT_ID=snwcmuptrvmpniuevofj

# --------------------------------------------------------------
# 2. SERVER-SIDE PUBLIC VARIABLES (Available during SSR execution)
# --------------------------------------------------------------
SUPABASE_URL=https://snwcmuptrvmpniuevofj.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_CqxydmwI2c6JScSdFg5X4Q_HmwDzvk9
SUPABASE_PROJECT_ID=snwcmuptrvmpniuevofj

# --------------------------------------------------------------
# 3. SERVER-SIDE SECRET (NEVER PREFIX WITH VITE_ !)
# --------------------------------------------------------------
# Security Rule: The secret key has full backend database access.
# It is used exclusively in server-side functions and never bundled to clients.
SUPABASE_SECRET_KEY=

# --------------------------------------------------------------
# 4. FASTAPI ML PRIORITY PREDICTION SERVICE
# --------------------------------------------------------------
# Local Development: Defaults to http://127.0.0.1:8000
# Production (Vercel): Set to your deployed Render URL:
VITE_ML_API_URL=https://fixlens-ml-api.onrender.com
